<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_white"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <!-- Circle Letter Badge -->
    <TextView
        android:id="@+id/tvSpotLetter"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="A1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_circle_blue_dark"
        android:gravity="center"
        android:layout_marginEnd="12dp" />

    <!-- Name + Type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSpotName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spot A-01"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvSpotType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standard · Free"
            android:textSize="11sp"
            android:textColor="#888888" />
    </LinearLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvSpotStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_badge_green"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginEnd="10dp" />

    <!-- Edit Button -->
    <ImageButton
        android:id="@+id/btnEdit"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_add"
        android:background="@drawable/bg_circle_green"
        android:contentDescription="Edit spot" />
</LinearLayout>
