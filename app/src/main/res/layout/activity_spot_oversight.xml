<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spot Oversight" android:textStyle="bold" android:textSize="22sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="87 active . 4 suspended" android:textColor="@color/text_muted"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All(28)" android:padding="8dp" android:background="@drawable/bg_chip_blue" android:textColor="@color/chip_blue_text"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active(28)" android:padding="8dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip_green" android:textColor="@color/green_text"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Suspended(4)" android:padding="8dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip_red" android:textColor="@color/red_text"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvOversight" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="16dp"/>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomAdmin" android:layout_width="match_parent" android:layout_height="wrap_content" app:menu="@menu/menu_admin_bottom"/>
</LinearLayout>
