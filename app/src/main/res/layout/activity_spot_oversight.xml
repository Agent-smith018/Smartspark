<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Spot Oversight" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="#222222"/>
                <TextView android:id="@+id/tvOversightCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="87 active . 4 suspended"
                    android:textSize="12sp" android:textColor="#888888"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_grey"
                android:src="@drawable/ic_search"
                android:contentDescription="Search" />
        </LinearLayout>

        <!-- Filter Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/tabAll"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="All(28)" android:textSize="12sp" android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_active"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/tabActive"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="Active(28)" android:textSize="12sp" android:textColor="#888888"
                    android:background="@drawable/bg_tab_outline"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center" android:layout_marginEnd="8dp"/>

                <TextView android:id="@+id/tabSuspended"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="Suspended(4)" android:textSize="12sp" android:textColor="#F44336"
                    android:background="@drawable/bg_tab_red_outline"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:gravity="center"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Spots List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOversightSpots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <LinearLayout android:id="@+id/navOverview" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_grid" android:contentDescription="Overview"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Overview" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navUsers" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_people" android:contentDescription="Users"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Users" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navSpots" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_home" android:contentDescription="Spots"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Spots" android:textSize="10sp" android:textColor="#1565C0"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navReports" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_flag" android:contentDescription="Reports"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Reports" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
