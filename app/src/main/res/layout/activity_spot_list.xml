<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_grey"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLotName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spot A - Rue Saint Denis"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvSpotsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28 Spots . 17 available"
                    android:textSize="13sp"
                    android:textColor="#4CAF50"
                    android:gravity="center" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_grey"
                android:src="@drawable/ic_search"
                android:contentDescription="Search" />
        </LinearLayout>

        <!-- Filter Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="All(28)"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_active"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabFree"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Free(17)"
                    android:textSize="12sp"
                    android:textColor="#4CAF50"
                    android:background="@drawable/bg_tab_green_outline"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabTaken"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Taken(11)"
                    android:textSize="12sp"
                    android:textColor="#F44336"
                    android:background="@drawable/bg_tab_red_outline"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Spots RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIndividualSpots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/navOverview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_grid" android:contentDescription="Overview"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Overview" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSpots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_home" android:contentDescription="Spots"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Spots" android:textSize="10sp" android:textColor="#4CAF50"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_person" android:contentDescription="Profile"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Profile" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
