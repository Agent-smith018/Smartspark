<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_white"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <!-- Parking icon -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_home"
        android:background="@drawable/bg_circle_grey"
        android:padding="8dp"
        android:contentDescription="Parking lot"
        android:layout_marginEnd="12dp" />

    <!-- Name + Owner -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLotName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spot A-Rue S..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvLotOwner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sophie M. · 25 spots"
            android:textSize="11sp"
            android:textColor="#888888" />
    </LinearLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_badge_green"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginEnd="10dp" />

    <!-- Action Button -->
    <ImageButton
        android:id="@+id/btnAction"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_add"
        android:background="@drawable/bg_circle_green"
        android:contentDescription="View spot" />
</LinearLayout>
