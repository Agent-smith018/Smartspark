<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_red_tint"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User abuse - Kevin Roy"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#B71C1C"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reported by 3 drivers for repeatedly submitting false spot data."
        android:textSize="12sp"
        android:textColor="#222222"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrimary"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Suspended user"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_red"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSecondary"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="View Profile"
            android:textColor="#1565C0"
            android:background="@drawable/bg_button_outline_blue"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
